# MongoDB connection string used by the backend and seed script.
MONGODB_URI=mongodb://127.0.0.1:27017/financial_analytics_dashboard

# JWT settings. Use a long, cryptographically random value in every real environment.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h

# Allowed Vite frontend origin for browser requests.
CORS_ORIGIN=http://localhost:5173

# Backend port (used when the backend is started)
PORT=3001

# Reserved for a future frontend-to-backend connection; no API is implemented yet.
VITE_API_URL=http://localhost:3001
